rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Atlas statistical reference data is globally readable
    match /countries/{countryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /observations/{obsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /indicators/{indicatorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ingestionLogs/{logId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
